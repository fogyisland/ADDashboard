<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <SelfContained>true</SelfContained>
    <BaseOutputPath>bin\PackageDesigner\</BaseOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Tests/**/*.cs" />
    <None Remove="Tests/**" />
    <Content Remove="Tests/**" />
    <EmbeddedResource Remove="Tests/**" />
    <Compile Remove="installer/**/*.cs" />
    <None Remove="installer/**" />
    <Content Remove="installer/**" />
    <EmbeddedResource Remove="installer/**" />
    <Compile Remove="publish/**/*.cs" />
    <None Remove="publish/**" />
    <Content Remove="publish/**" />
    <EmbeddedResource Remove="publish/**" />
    <Compile Remove="smoke/**/*.cs" />
    <None Remove="smoke/**" />
    <Content Remove="smoke/**" />
    <EmbeddedResource Remove="smoke/**" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Resources\manifest-schema.json" />
    <EmbeddedResource Include="Resources\manifest-schema.json" />
    <None Remove="Resources\templates\*.zip" />
    <EmbeddedResource Include="Resources\templates\*.zip" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Meziantou.Framework.Win32.CredentialManager" Version="1.2.0" />
    <PackageReference Include="NJsonSchema" Version="11.0.0" />
  </ItemGroup>
</Project>