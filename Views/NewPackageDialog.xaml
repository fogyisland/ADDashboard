<Window x:Class="PackageDesigner.Views.NewPackageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Package" Width="440" Height="260" WindowStartupLocation="CenterOwner">
  <StackPanel Margin="20">
    <TextBlock Text="New package" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4"/>
    <TextBlock Text="Pick a starter template and give the package a name. The three elements (manifest, migrations, collect.ps1) are auto-populated from the template."
               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>
    <Grid Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="120"/><ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition/><RowDefinition/>
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Grid.Column="0" Text="Template" Style="{StaticResource FieldLabel}"/>
      <ComboBox   Grid.Row="0" Grid.Column="1" x:Name="TemplateBox" SelectedIndex="0">
        <ComboBoxItem Content="ad-monitoring-lite (AD)"/>
        <ComboBoxItem Content="ad-os-baseline-lite (Non-AD)"/>
      </ComboBox>
      <TextBlock Grid.Row="1" Grid.Column="0" Text="Package name" Style="{StaticResource FieldLabel}"/>
      <TextBox   Grid.Row="1" Grid.Column="1" x:Name="NameBox"/>
    </Grid>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Cancel" Width="90" Margin="0,0,8,0" Click="Cancel_Click" IsCancel="True"/>
      <Button Content="Create" Width="90" Click="OK_Click" IsDefault="True" Style="{StaticResource PrimaryButton}"/>
    </StackPanel>
  </StackPanel>
</Window>
