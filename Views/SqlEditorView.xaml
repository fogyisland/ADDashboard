<UserControl x:Class="PackageDesigner.Views.SqlEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit">
  <DockPanel>
    <avalon:TextEditor x:Name="Editor" FontFamily="Consolas" FontSize="13"
                       ShowLineNumbers="True" SyntaxHighlighting="SQL" />
    <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}" Padding="8,4"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
      <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
    </Border>
  </DockPanel>
</UserControl>