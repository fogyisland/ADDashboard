<Window x:Class="PackageDesigner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PackageDesigner.Views"
        xmlns:conv="clr-namespace:PackageDesigner.Converters">
  <Window.Resources>
    <conv:ZeroToVisibilityConverter x:Key="ZeroToVisibility"/>
  </Window.Resources>
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="_New…" Click="New_Click"/>
        <MenuItem Header="_Open…" Click="Open_Click"/>
        <MenuItem Header="_Save" Click="Save_Click"/>
        <Separator/>
        <MenuItem Header="E_xit" Click="Exit_Click"/>
      </MenuItem>
      <MenuItem Header="_Publish">
        <MenuItem Header="_Publish to Center…" Click="Publish_Click"/>
        <MenuItem Header="_Settings…" Click="Settings_Click"/>
      </MenuItem>
    </Menu>
    <StatusBar DockPanel.Dock="Bottom">
      <StatusBarItem><TextBlock x:Name="StatusText" Text="Ready"/></StatusBarItem>
    </StatusBar>
    <Grid>
      <TabControl ItemsSource="{Binding OpenTabs}" SelectedItem="{Binding ActiveTab}">
        <TabControl.ItemTemplate>
          <DataTemplate><TextBlock Text="{Binding Project.Manifest.Name}"/></DataTemplate>
        </TabControl.ItemTemplate>
        <TabControl.ContentTemplate>
          <DataTemplate>
            <views:PackageTabView DataContext="{Binding}"/>
          </DataTemplate>
        </TabControl.ContentTemplate>
      </TabControl>
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                  Visibility="{Binding OpenTabs.Count, Converter={StaticResource ZeroToVisibility}}">
        <TextBlock Text="Package Designer" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,8"/>
        <TextBlock Text="Open an existing .pkgproj or create a new package to get started."
                   HorizontalAlignment="Center" Margin="0,0,0,20" Foreground="#666"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <Button Content="_New…" Width="110" Height="32" Margin="6" Click="New_Click" IsDefault="True"/>
          <Button Content="_Open…" Width="110" Height="32" Margin="6" Click="Open_Click"/>
        </StackPanel>
      </StackPanel>
    </Grid>
  </DockPanel>
</Window>