node_modules/
dist/
# Runtime install marker (written by scripts/install-center.ps1 Ensure-CenterNodeModules)
center/.install-hash
.env
.env.local
*.log
appsettings.json
!appsettings.example.json
coverage/
.nyc_output/
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# Claude Code local state
.claude/
# Brainstorm server runtime scratch (server pid, instance id, draft content)
.superpowers/brainstorm/
# Native git worktrees under .worktrees/ (created by subagent-driven-development)
.worktrees/

# Agent runtime SQLite queue (regenerated on each agent start)
agent/queue.db
agent/queue.db-shm
agent/queue.db-wal

# Dev-only Chrome DevTools redirect helper (local debugging)
scripts/cdp-redirect.js

# Dev-only JWT minter for local smoke tests (hardcoded dev secret; see scripts/sign-token.mjs)
scripts/sign-token.mjs

# Runtime dev data (SQLite databases, plugin test fixtures).
# Narrow from `data/` to `center/data/` so bundled built-in package sources
# under publish/center/data/packages/<name>/<version>/ remain tracked (their
# negations are listed below).
center/data/

# NSSM binary downloaded by Ensure-Nssm.ps1 (auto-installed on first deploy)
nssm/
nssm.zip
# ...but the published copy under publish/nssm/ IS tracked as a release artifact
!publish/nssm/

# Green version bundle (publish/) — source code is tracked, build artifacts are not.
# Exception: publish/system/center/dist/ IS tracked so the bundle ships the
# exact build output (avoids cloud-server rebuild drift — see 2026-08-22 lesson).
# The negation below re-includes the shipped web bundle (overrides dist/ on line 2).
publish/center/node_modules/
publish/agent/node_modules/
!publish/system/center/dist/
# Runtime bundle (publish/system/) must NOT contain test files — operators
# unzip publish.zip to C:\addashboard on Windows servers; test code in the
# bundle is dead weight + leaks internal test fixtures. Source tests live
# under <pkg>/tests/ at the repo root and are NEVER mirrored (see
# scripts/verify-mirror.ps1's $skipSubdirs). Direct matches here catch
# stray additions (e.g., vitest.config.js, smoke-test.ps1) that bypass the
# mirror convention.
publish/system/**/tests/
publish/system/**/*.test.js
publish/system/**/*.spec.js
publish/system/**/vitest.config.js
publish/system/**/smoke-test.ps1
# WPF PackageDesigner self-contained build output (rebuilt via `dotnet publish`)
publish/designer/

# Built-in package sources (shipped via publish.zip, versioned in git so the
# seeder has a stable on-disk source — see center/src/services/builtin-packages.js).
# These are authored source artifacts, not runtime data; the `center/data/`
# rule above covers only the runtime cache, not these bundled sources.
!/publish/center/data/packages/ad_os_baseline/
!/publish/center/data/packages/ad_os_baseline/1.0.0/
!/publish/center/data/packages/ad_os_baseline/1.0.0/manifest.json
!/publish/center/data/packages/ad_os_baseline/1.0.0/collect.ps1
!/publish/center/data/packages/ad_os_baseline/1.0.0/content.sha256
!/publish/center/data/packages/ad_os_baseline/1.0.0/migrations/001_initial.sql

# Leftover zips dropped in publish/ by user tooling (re-zip if needed)
publish/db.zip
publish/publish.zip

# .NET build outputs (PackageDesigner WPF app)
**/bin/
**/obj/

# MSI installer staging (build-time only, regenerated by build-msi.cmd)
installer/staging/
publish/installer/staging/
# Green package staging (build-time only, moved to agentInstall/ at end)
publish/installer/staging-agentInstall/
# MSI build output (WiX 5 writes under installer/agent-installer/bin/, but a
# future `wix build` invocation could drop a .msi outside that directory)
*.msi
# Published MSI installer is a release artifact — track it
!publish/installer/ADDashboardAgent.msi
# Green package build outputs are release artifacts — track them
!publish/installer/agentInstall/
!publish/installer/agentInstall.zip
