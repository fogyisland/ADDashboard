node_modules/
dist/
# Runtime install marker (written by scripts/install-center.ps1 Ensure-CenterNodeModules)
center/.install-hash
.env
.env.local
*.log
appsettings.json
!appsettings.example.json
coverage/
.nyc_output/
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# Claude Code local state
.claude/
# Brainstorm server runtime scratch (server pid, instance id, draft content)
.superpowers/brainstorm/
# Native git worktrees under .worktrees/ (created by subagent-driven-development)
.worktrees/

# Agent runtime SQLite queue (regenerated on each agent start)
agent/queue.db
agent/queue.db-shm
agent/queue.db-wal

# Dev-only Chrome DevTools redirect helper (local debugging)
scripts/cdp-redirect.js

# Dev-only JWT minter for local smoke tests (hardcoded dev secret; see scripts/sign-token.mjs)
scripts/sign-token.mjs

# Dev-only mock-agent scratch (ad-hoc end-to-end checks against a live center)
mock-agent/
agent/data/

# Runtime dev data (SQLite databases, plugin test fixtures).
# Narrow from `data/` to `center/data/` so bundled built-in package sources
# under publish/system/center/data/packages/<name>/<version>/ remain tracked
# (their negations are listed at the bottom of this file).
center/data/

# NSSM binary downloaded by Ensure-Nssm.ps1 (auto-installed on first deploy)
nssm/
nssm.zip
# ...but the published copy under publish/nssm/ IS tracked as a release artifact
!publish/nssm/

# Node 20 LTS portable (85 MB extracted) staged at publish/system/node/.
# Build artifact — downloaded by scripts/common/Ensure-Node.ps1 and copied into
# the green package's agentInstall/node/ by installer/build-green-package.ps1.
# Tracked only inside the green package zip (operator artifact); the staging
# dir itself stays untracked so the repo doesn't carry the binary.
publish/system/node/

# Green version bundle (publish/) — source code is tracked, build artifacts are not.
# Exception: publish/system/center/dist/ IS tracked so the bundle ships the
# exact build output (avoids cloud-server rebuild drift — see 2026-08-22 lesson).
# The negation below re-includes the shipped web bundle (overrides dist/ on line 2).
publish/center/node_modules/
publish/agent/node_modules/
!publish/system/center/dist/
# Runtime bundle (publish/system/) must NOT contain test files — operators
# unzip publish.zip to C:\addashboard on Windows servers; test code in the
# bundle is dead weight + leaks internal test fixtures. Source tests live
# under <pkg>/tests/ at the repo root and are NEVER mirrored (see
# scripts/verify-mirror.ps1's $skipSubdirs). Direct matches here catch
# stray additions (e.g., vitest.config.js, smoke-test.ps1) that bypass the
# mirror convention.
publish/system/**/tests/
publish/system/**/*.test.js
publish/system/**/*.spec.js
publish/system/**/vitest.config.js
publish/system/**/smoke-test.ps1
# WPF PackageDesigner self-contained build output (rebuilt via `dotnet publish`)
publish/designer/

# Built-in package sources (shipped via publish.zip, versioned in git so the
# seeder has a stable on-disk source — see center/src/services/builtin-packages.js).
# These are authored source artifacts, not runtime data; the `center/data/`
# rule above covers only the runtime cache, not these bundled sources. Note
# the path is publish/system/center/data/packages/ (R82 split), NOT the older
# publish/center/data/packages/ path that these negations referenced before
# R83 (commit 6b2c269) — when R83 dropped the entire built-in tree from the
# working copy, the old path-based whitelist silently failed to keep them
# tracked and tests broke (see publish-data-mirror-gap plan). Five built-ins
# are listed (ad_os_baseline, ad_domain_consistency, ad_local_port_check,
# ad_lockout_summary, ad_lockout_list); see BUILTIN_PACKAGES in
# center/src/services/builtin-packages.js for the canonical list. The
# test center/tests/services/builtin-packages-tracked.test.js asserts
# every listed file is actually tracked, so a future publish rebuild that
# drops the tree again is caught in CI rather than at runtime.
!/publish/system/center/data/packages/ad_os_baseline/
!/publish/system/center/data/packages/ad_os_baseline/1.0.0/
!/publish/system/center/data/packages/ad_os_baseline/1.0.0/manifest.json
!/publish/system/center/data/packages/ad_os_baseline/1.0.0/collect.ps1
!/publish/system/center/data/packages/ad_os_baseline/1.0.0/content.sha256
!/publish/system/center/data/packages/ad_os_baseline/1.0.0/migrations/001_initial.sql
!/publish/system/center/data/packages/ad_os_baseline/1.0.0/migrations/mssql/001_initial.sql
!/publish/system/center/data/packages/ad_domain_consistency/
!/publish/system/center/data/packages/ad_domain_consistency/1.0.0/
!/publish/system/center/data/packages/ad_domain_consistency/1.0.0/manifest.json
!/publish/system/center/data/packages/ad_domain_consistency/1.0.0/collect.ps1
!/publish/system/center/data/packages/ad_domain_consistency/1.0.0/migrations/001_initial.sql
!/publish/system/center/data/packages/ad_domain_consistency/1.0.0/migrations/mssql/001_initial.sql
!/publish/system/center/data/packages/ad_local_port_check/
!/publish/system/center/data/packages/ad_local_port_check/1.0.0/
!/publish/system/center/data/packages/ad_local_port_check/1.0.0/manifest.json
!/publish/system/center/data/packages/ad_local_port_check/1.0.0/collect.ps1
!/publish/system/center/data/packages/ad_local_port_check/1.0.0/migrations/001_initial.sql
!/publish/system/center/data/packages/ad_local_port_check/1.0.0/migrations/mssql/001_initial.sql
!/publish/system/center/data/packages/ad_lockout_summary/
!/publish/system/center/data/packages/ad_lockout_summary/1.0.0/
!/publish/system/center/data/packages/ad_lockout_summary/1.0.0/manifest.json
!/publish/system/center/data/packages/ad_lockout_summary/1.0.0/collect.ps1
!/publish/system/center/data/packages/ad_lockout_summary/1.0.0/migrations/001_initial.sql
!/publish/system/center/data/packages/ad_lockout_summary/1.0.0/migrations/mssql/001_initial.sql
!/publish/system/center/data/packages/ad_lockout_list/
!/publish/system/center/data/packages/ad_lockout_list/1.0.0/
!/publish/system/center/data/packages/ad_lockout_list/1.0.0/manifest.json
!/publish/system/center/data/packages/ad_lockout_list/1.0.0/collect.ps1
!/publish/system/center/data/packages/ad_lockout_list/1.0.0/migrations/001_initial.sql
!/publish/system/center/data/packages/ad_lockout_list/1.0.0/migrations/mssql/001_initial.sql

# Leftover zips dropped in publish/ by user tooling (re-zip if needed)
publish/db.zip
publish/publish.zip

# .NET build outputs (PackageDesigner WPF app)
**/bin/
**/obj/

# MSI installer staging (build-time only, regenerated by build-msi.cmd)
installer/staging/
publish/installer/staging/
# Green package staging (build-time only, moved to agentInstall/ at end)
publish/installer/staging-agentInstall/
# MSI build output (WiX 5 writes under installer/agent-installer/bin/, but a
# future `wix build` invocation could drop a .msi outside that directory)
*.msi
# Published MSI installer is a release artifact — track it
!publish/installer/ADDashboardAgent.msi
# Green package build outputs are release artifacts — track them
!publish/installer/agentInstall/
!publish/installer/agentInstall.zip
# agentInstall/agent/node_modules is generated ON DEMAND on the
# TARGET machine by install-agent.ps1 (called from start.ps1):
#   `& <green>/node/npm.cmd install --omit=dev --no-audit --no-fund`
# against <InstallPath>/package.json. As of R91.x, the green package
# does NOT ship pre-built node_modules — operator directive 2026-09-24
# clarified "我们需要在start.ps1 中构建node_modules" (build it during
# install, not pre-bundle). Stays untracked because it's a runtime
# build artifact (~50-80 MB) regenerated on every install from the
# tracked package.json.
#
# EXCEPTION: agentInstall/node/node_modules/ stays untracked — it's the
# Node 20 portable zip's internal node_modules/ (npm + npm-cli.js).
# That tree is downloaded by Ensure-Node.ps1 from nodejs.org and is
# regenerable from a single source URL; no need to carry it in git.
publish/installer/agentInstall/agent/node_modules/
publish/installer/agentInstall/node/node_modules/

# Local session temp tokens (created by Claude Code hooks)
*token*.txt

# Local dev scratch (Claude Code ad-hoc checklists + progress notes)
# These live at the repo root as the session's working memory; they
# have no value to other developers and would clutter git history if
# committed. Claude writes them under memory/ during interactive
# sessions, then the operator decides whether to promote anything
# into the long-term memory directory (~/.claude/projects/...) manually.
memory/
