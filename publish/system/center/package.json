    "jsonwebtoken": "^9.0.2",
    "mssql": "^11.0.1",
    "mysql2": "^3.11.0",
    "nodemailer": "^6.9.0",
    "papaparse": "^5.5.4",
    "pinia": "^2.2.4",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "pino-roll": "^4.0.0",
