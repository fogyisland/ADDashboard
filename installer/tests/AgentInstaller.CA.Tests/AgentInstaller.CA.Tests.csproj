<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      Target net472 to match AgentInstaller.CA.csproj. The CA assembly is built
      as AnyCPU-friendly net472 and uses WixToolset.Dtf.CustomAction 5.0.2
      (net20 + net462 reference assemblies), so the test runner must also be
      net472 to load it. The MSI WiX project itself (AgentInstaller.csproj)
      uses WixToolset.Sdk/5.0.2 + net8.0 — that one is NOT referenced here.
    -->
    <TargetFramework>net472</TargetFramework>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
    <ProjectGuid>{D7E9F3A1-CCCC-DDDD-EEEE-FFFF00001111}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>ADDashboard.AgentInstaller.CA.Tests</RootNamespace>
    <AssemblyName>ADDashboard.AgentInstaller.CA.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <Deterministic>true</Deterministic>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <!--
      Match the CA assembly's IntermediateOutputPath pattern (see root
      Directory.Build.props) so each project's obj\ stays isolated. Otherwise
      obj\project.assets.json would be shared with PackageDesigner.Tests.
    -->
    <BaseIntermediateOutputPath>obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <!--
      The CA assembly is referenced by relative path because the project lives
      at installer/tests/AgentInstaller.CA.Tests/ and the CA at
      installer/agent-installer/CA/. Going up two levels lands on installer\.
      ProjectReference restores NuGet refs and propagates the internal-visibility
      grant declared in AgentInstaller.CA.csproj via <InternalsVisibleTo />.
    -->
    <ProjectReference Include="..\..\agent-installer\CA\AgentInstaller.CA.csproj" />
  </ItemGroup>
</Project>