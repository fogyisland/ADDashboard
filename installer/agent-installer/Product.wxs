<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="$(var.ProductName)"
           Version="$(var.ProductVersion)"
           Manufacturer="$(var.Manufacturer)"
           UpgradeCode="$(var.UpgradeCode)"
           ProductCode="$(var.ProductCode)"
           InstallerVersion="500"
           Language="2052">
    <MajorUpgrade Schedule="afterInstallInitialize"
                  DowngradeErrorMessage="A newer version of $(var.ProductName) is already installed."
                  AllowSameVersionUpgrades="no" />

    <!--
      Block install on anything below Windows 10 / Server 2016 (both report
      VersionNT64 = 1000). See https://learn.microsoft.com/en-us/windows/win32/msi/versionnt
    -->
    <Launch Message="AD Dashboard Agent requires Windows 10 / Server 2016 or later (x64)."
            Condition="Installed OR VersionNT64 &gt;= 1000" />

    <Media Id="1" Cabinet="agent" EmbedCab="yes" CompressionLevel="high" />

    <Feature Id="AgentFeature" Title="AD Dashboard Agent" Level="1">
      <ComponentGroupRef Id="AgentComponents" />
    </Feature>

    <UI>
      <ui:WixUI Id="WixUI_Minimal" />
    </UI>

    <Property Id="WIXUI_INSTALLDIR" Value="C:\addashboard\Agent" />

    <!-- MSI properties consumed by ConfigureAgentAction.
         CenterUrl / AgentToken / AgentType are passed at install time via
         `msiexec /i ... CENTERURL=... AGENTTOKEN=... AGENTTYPE=...`.
         CENTERURL and AGENTTOKEN are marked Hidden to suppress them in the
         verbose MSI log (msiexec /l*v) and to ensure they're persisted in
         the Property table — without Hidden/Secure/Admin, WiX 5 ignores
         empty <Property> elements.
         AgentType defaults to "ad"; PreserveAppsettings defaults to "0" so a
         fresh install always writes appsettings.json. -->
    <Property Id="CENTERURL" Hidden="yes" />
    <Property Id="AGENTTOKEN" Hidden="yes" />
    <Property Id="AGENTTYPE" Value="ad" />
    <Property Id="PRESERVE_APPSETTINGS" Value="0" />

    <!-- Link CustomActions.wxs into the Package. WiX 5 fragments are only
         pulled into the linker if something reachable from Package references
         an element inside them. One <CustomActionRef> drags in the whole
         fragment, including Binary "CA.dll", all three <CustomAction>s, and
         the <InstallExecuteSequence>. Without this ref the fragment is an
         orphan and the built MSI contains no CA.dll, no CustomAction rows,
         and no sequence rows for our pipeline (C-1). -->
    <CustomActionRef Id="ConfigureAgent" />
  </Package>

  <Fragment>
    <!-- INSTALLDIR's full path is governed by WIXUI_INSTALLDIR = C:\addashboard\Agent.
         WIXUI_INSTALLDIR overrides the Name attribute below at install time. -->
    <Directory Id="INSTALLDIR" Name="Agent">
      <Directory Id="INSTALLDIR.src" Name="src" />
      <Directory Id="INSTALLDIR.node" Name="node" />
      <Directory Id="INSTALLDIR.node_modules" Name="node_modules" />
      <Directory Id="INSTALLDIR.scripts" Name="scripts" />
      <Directory Id="INSTALLDIR.nssm" Name="nssm" />
    </Directory>
  </Fragment>
</Wix>
