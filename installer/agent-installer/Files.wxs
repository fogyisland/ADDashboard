<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="Agent.AppsettingsTemplate" Guid="{D7E9F3A1-1111-2222-3333-444455556666}">
        <File Id="Agent.AppsettingsTemplate.File"
              Source="$(var.StagingDir)\appsettings.template.json"
              KeyPath="yes" />
      </Component>

      <Component Id="Agent.Main" Guid="{D7E9F3A1-2222-3333-4444-555566667777}">
        <File Id="Agent.Main.File"
              Source="$(var.StagingDir)\agent\agent.js"
              KeyPath="yes" />
      </Component>

      <!-- Ships agent/package.json. Without this file, Node 20 parses agent.js
           as CommonJS and the ESM `import` statements at agent.js:1-18 throw
           "SyntaxError: Cannot use import statement outside a module". -->
      <Component Id="Agent.PackageJson" Guid="{D7E9F3A1-7777-8888-9999-AAAABBBBCCCC}">
        <File Id="Agent.PackageJson.File"
              Source="$(var.StagingDir)\agent\package.json"
              KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="INSTALLDIR.node">
      <Component Id="Agent.Node" Guid="{D7E9F3A1-6666-7777-8888-999900001111}">
        <File Id="Agent.Node.Exe"
              Source="$(var.StagingDir)\node\node.exe"
              KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="INSTALLDIR.scripts">
      <Component Id="Agent.Scripts.Replication" Guid="{D7E9F3A1-4444-5555-6666-777788889999}">
        <File Id="Agent.Scripts.Replication.File"
              Source="$(var.StagingDir)\agent\scripts\collect-replication.ps1"
              KeyPath="yes" />
      </Component>
      <Component Id="Agent.Scripts.Discovery" Guid="{D7E9F3A1-5555-6666-7777-888899990000}">
        <File Id="Agent.Scripts.Discovery.File"
              Source="$(var.StagingDir)\agent\scripts\collect-discovery.ps1"
              KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="INSTALLDIR.nssm">
      <Component Id="Agent.Nssm" Guid="{D7E9F3A1-8888-9999-0000-111122223333}">
        <File Id="Agent.Nssm.Exe"
              Source="$(var.StagingDir)\nssm\nssm.exe"
              KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <ComponentGroup Id="AgentComponents">
      <ComponentRef Id="Agent.AppsettingsTemplate" />
      <ComponentRef Id="Agent.Main" />
      <ComponentRef Id="Agent.PackageJson" />
      <ComponentRef Id="Agent.Node" />
      <ComponentRef Id="Agent.Scripts.Replication" />
      <ComponentRef Id="Agent.Scripts.Discovery" />
      <ComponentRef Id="Agent.Nssm" />
      <!-- WiX 5 auto-harvests Files into Components keyed per file. -->
      <Files Include="$(var.StagingDir)\agent\src\**" Directory="INSTALLDIR.src" />
      <!-- node_modules: ~700+ files (axios + better-sqlite3 native + pino + transitive).
           WiX 5 generates a Component per harvested file with ComponentId="*". -->
      <Files Include="$(var.StagingDir)\node_modules\**" Directory="INSTALLDIR.node_modules" />
    </ComponentGroup>

    <!--
      Custom action pipeline. The CustomActionData string assembled by
      ScheduleConfigureAgent is consumed by the deferred ConfigureAgent at
      install time. RollbackAgent runs in the rollback path so an install
      failure mid-CustomAction cleans up the NSSM-registered service.
      See installer/agent-installer/CA/ConfigureAgentAction.cs for the body.

      R1: Service runs as LocalSystem (NSSM default for `nssm install` when
      no ObjectName is set), matching install-agent.ps1.
    -->
    <Binary Id="CA.dll" SourceFile="$(var.AgentInstaller.CA.TargetPath)" />

    <CustomAction Id="ScheduleConfigureAgent"
                  Return="check"
                  Property="ConfigureAgent"
                  Value="INSTALLDIR=[INSTALLDIR];CENTERURL=[CENTERURL];AGENTTOKEN=[AGENTTOKEN];AGENTTYPE=[AGENTTYPE];PRESERVE_APPSETTINGS=[PRESERVE_APPSETTINGS]" />

    <CustomAction Id="ConfigureAgent"
                  BinaryRef="CA.dll"
                  DllEntry="ConfigureAgent"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <CustomAction Id="RollbackAgent"
                  BinaryRef="CA.dll"
                  DllEntry="RollbackAgent"
                  Execute="rollback"
                  Impersonate="no"
                  Return="ignore" />

    <InstallExecuteSequence>
      <!-- WiX 5 syntax: <Custom Action="..." After="..." Condition="..."/> is
           self-closing. The "virtual " prefix tells WiX to NOT generate a
           CustomAction table entry for the scheduling entry — the actual
           custom action (ScheduleConfigureAgent above) already exists, and
           the virtual entry just places it in the sequence. The condition
           gates when it runs.
           NOT Installed OR REINSTALL: first install or reinstall (re-set
           NSSM params on upgrade). -->
      <Custom Action="ScheduleConfigureAgent" After="InstallFiles" Condition="NOT Installed OR REINSTALL" />
      <Custom Action="ConfigureAgent" After="ScheduleConfigureAgent" Condition="NOT Installed OR REINSTALL" />
      <Custom Action="RollbackAgent" Before="ConfigureAgent" Condition="NOT Installed OR REINSTALL" />
    </InstallExecuteSequence>
  </Fragment>
</Wix>
