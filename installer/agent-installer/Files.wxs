<?xml version="1.0" encoding="utf-8"?>
<!--
  Task 7 — appsettings.json ownership and upgrade preservation rationale.

  THE RUNTIME appsettings.json IS NOT STAGED FROM THIS MSI.

  This File table only ships appsettings.template.json (the literal, unchanged
  copy of the staging file). The runtime appsettings.json that the agent
  process reads is GENERATED at install time by the deferred
  ConfigureAgentAction (see CA/ConfigureAgentAction.cs::WriteAppsettingsJson),
  which fills in CENTERURL / AGENTTOKEN / AGENTTYPE / hostname / paths from
  MSI Properties. That file is user-config data, not part of the File table.

  THE BRIEF'S TASK 7 STEP 1 WAS DELIBERATELY NOT IMPLEMENTED.

  The brief asks us to add a second <Component Id="Agent.Appsettings" ...>
  with <File Source="$(var.StagingDir)\appsettings.template.json"
  Name="appsettings.json" NeverOverwrite="yes">. This would conflict with the
  existing Agent.AppsettingsTemplate <File> for two reasons:

    1. Both <File>s would resolve to the same staging source path. WiX 5
       emits one File-table row per <File>; two rows keyed on the same
       source file would trigger ICE03 / ICE38 / ICE91 validation errors
       ("two components share the same keypath"). Even with NeverOverwrite
       set, the duplicate-keypath conflict fires at LINK time, not at
       install time, so suppression tricks don't help.

    2. appsettings.json is created by ConfigureAgentAction at install time
       and is NOT in the File table. NeverOverwrite is meaningless for a
       file that no <File> owns — there is no copy-from-staging step to
       gate. The only MSI-native way to gate the runtime file's overwrite
       would be to add it to the File table, which is what the brief
       asks — and which triggers issue (1) above.

  THE REAL OVERWRITE GATE LIVES IN WriteAppsettingsJson.

  Preserving appsettings.json across reinstall / major upgrade is done at
  the CA layer: if PRESERVE_APPSETTINGS=1 is passed on the msiexec command
  line AND appsettings.json already exists on disk, WriteAppsettingsJson
  short-circuits and returns without overwriting
  (CA/ConfigureAgentAction.cs lines 82-83). The default (PRESERVE_APPSETTINGS=0)
  rewrites appsettings.json on every install — same as a fresh install.

  PRESERVE_APPSETTINGS plumb-through:
    Properties.wxs defines <Property Id="PRESERVE_APPSETTINGS" Value="0"/>.
    CustomActions.wxs ScheduleConfigureAgent expands
    PRESERVE_APPSETTINGS=[PRESERVE_APPSETTINGS] into the deferred CA's
    CustomActionData. ConfigureAgentAction.ParseCustomActionData reads it
    into data.PreserveAppsettings. WriteAppsettingsJson gates on it.

  R2 / Uninstall behavior (kept):
    appsettings.json is generated by the CA, so it's not in the File table,
    so MSI's built-in RemoveFiles does NOT delete it on uninstall. The user
    can manually clear C:\addashboard\Agent or use Add/Remove Programs. This
    branch accepts that — never reintroduce appsettings.json as a <File>
    without first changing R2 and re-deciding the uninstall semantics.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="Agent.AppsettingsTemplate" Guid="{D7E9F3A1-1111-2222-3333-444455556666}">
        <File Id="Agent.AppsettingsTemplate.File"
              Source="$(var.StagingDir)\appsettings.template.json"
              KeyPath="yes" />
      </Component>

      <Component Id="Agent.Main" Guid="{D7E9F3A1-2222-3333-4444-555566667777}">
        <File Id="Agent.Main.File"
              Source="$(var.StagingDir)\agent\agent.js"
              KeyPath="yes" />
      </Component>

      <!-- Ships agent/package.json. Without this file, Node 20 parses agent.js
           as CommonJS and the ESM `import` statements at agent.js:1-18 throw
           "SyntaxError: Cannot use import statement outside a module". -->
      <Component Id="Agent.PackageJson" Guid="{D7E9F3A1-7777-8888-9999-AAAABBBBCCCC}">
        <File Id="Agent.PackageJson.File"
              Source="$(var.StagingDir)\agent\package.json"
              KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="INSTALLDIR.node">
      <Component Id="Agent.Node" Guid="{D7E9F3A1-6666-7777-8888-999900001111}">
        <File Id="Agent.Node.Exe"
              Source="$(var.StagingDir)\node\node.exe"
              KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="INSTALLDIR.scripts">
      <Component Id="Agent.Scripts.Replication" Guid="{D7E9F3A1-4444-5555-6666-777788889999}">
        <File Id="Agent.Scripts.Replication.File"
              Source="$(var.StagingDir)\agent\scripts\collect-replication.ps1"
              KeyPath="yes" />
      </Component>
      <Component Id="Agent.Scripts.Discovery" Guid="{D7E9F3A1-5555-6666-7777-888899990000}">
        <File Id="Agent.Scripts.Discovery.File"
              Source="$(var.StagingDir)\agent\scripts\collect-discovery.ps1"
              KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="INSTALLDIR.nssm">
      <Component Id="Agent.Nssm" Guid="{D7E9F3A1-8888-9999-0000-111122223333}">
        <File Id="Agent.Nssm.Exe"
              Source="$(var.StagingDir)\nssm\nssm.exe"
              KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <ComponentGroup Id="AgentComponents">
      <ComponentRef Id="Agent.AppsettingsTemplate" />
      <ComponentRef Id="Agent.Main" />
      <ComponentRef Id="Agent.PackageJson" />
      <ComponentRef Id="Agent.Node" />
      <ComponentRef Id="Agent.Scripts.Replication" />
      <ComponentRef Id="Agent.Scripts.Discovery" />
      <ComponentRef Id="Agent.Nssm" />
      <!-- WiX 5 auto-harvests Files into Components keyed per file. -->
      <Files Include="$(var.StagingDir)\agent\src\**" Directory="INSTALLDIR.src" />
      <!-- node_modules: ~700+ files (axios + better-sqlite3 native + pino + transitive).
           WiX 5 generates a Component per harvested file with ComponentId="*". -->
      <Files Include="$(var.StagingDir)\node_modules\**" Directory="INSTALLDIR.node_modules" />
    </ComponentGroup>
  </Fragment>
</Wix>
